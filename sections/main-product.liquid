 <style>
  /* Safely hide duplicate preview badges without disrupting review plugin UI */
  .product__info-container .jdgm-prev-badge + .jdgm-prev-badge,
  .product__info-container .jdgm-preview-badge + .jdgm-preview-badge,
  .product__info-container .spr-badge + .spr-badge,
  .product__info-container .rating + .rating {
    display: none !important;
  }

  /* Add generous side padding to "You may also like" section */
  .product-recommendations,
  .product__complementary-products,
  .complementary-products,
  .related-products,
  [data-url*='recommendations'] {
    padding-top: 4rem !important;
    padding-bottom: 4rem !important;
    padding-left: 6rem !important;
    padding-right: 6rem !important;
    max-width: 1400px !important;
    margin-left: auto !important;
    margin-right: auto !important;
    box-sizing: border-box !important;
  }

  .product-recommendations .grid,
  .product-recommendations .slider,
  .product-recommendations .product-grid,
  .complementary-products .grid,
  .complementary-products .slider {
    padding-left: 2rem !important;
    padding-right: 2rem !important;
  }

  @media screen and (max-width: 749px) {
    .product-recommendations,
    .product__complementary-products,
    .complementary-products,
    .related-products,
    [data-url*='recommendations'] {
      padding-left: 2rem !important;
      padding-right: 2rem !important;
    }

    .product-recommendations .grid,
    .product-recommendations .slider,
    .complementary-products .grid,
    .complementary-products .slider {
      padding-left: 0 !important;
      padding-right: 0 !important;
    }
  }
</style>
 
<!--
  Variant price synchronization: keeps the storefront price and cart variant
  in sync with Shopify's native variant prices.
-->
<script>
  (function () {
    'use strict';

    var productVariants = {{ product.variants | json }};
    if (!productVariants || !productVariants.length) return;

    function money(value) {
      // Shopify stores prices in the JSON as the shop's currency subunits.
      // Use Shopify's money_format when available; otherwise fall back to INR-style output.
      var amount = Number(value) / 100;
      try {
        if (window.Shopify && typeof Shopify.formatMoney === 'function') {
          return Shopify.formatMoney(value, {{ shop.money_format | json }});
        }
      } catch (e) {}
      return amount.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function getSelectedOptions(root) {
      var values = [];
      var fields = root.querySelectorAll('input[name^="options["], select[name^="options["]');

      fields.forEach(function (field) {
        if (field.type === 'radio' || field.type === 'checkbox') {
          if (field.checked) values.push(field.value);
        } else {
          values.push(field.value);
        }
      });

      return values;
    }

    function findVariant(root) {
      var selected = getSelectedOptions(root);
      if (!selected.length) return null;

      return productVariants.find(function (variant) {
        return variant.options.every(function (option, index) {
          return String(option) === String(selected[index]);
        });
      }) || null;
    }

    function updatePrice(root, variant) {
      if (!variant) return;

      var price = money(variant.price);
      var compare = variant.compare_at_price ? money(variant.compare_at_price) : '';

      // Update the standard Dawn price markup and any price element inside this product.
      var regularPrices = root.querySelectorAll('.price-item--regular');
      regularPrices.forEach(function (el) { el.textContent = price; });

      var salePrices = root.querySelectorAll('.price-item--sale');
      salePrices.forEach(function (el) { el.textContent = price; });

      // Also support custom price markup used by this storefront.
      root.querySelectorAll('[data-variant-price], .product-price, .product__price').forEach(function (el) {
        if (!el.closest('.price') || el.hasAttribute('data-variant-price')) {
          el.textContent = price;
        }
      });

      if (compare) {
        root.querySelectorAll('.price__sale .price-item--regular, .price__compare').forEach(function (el) {
          el.textContent = compare;
        });
      }
    }

    function updateVariantId(root, variant) {
      if (!variant) return;
      root.querySelectorAll('form[action*="/cart/add"] input[name="id"], form[action*="/cart/add"] select[name="id"]').forEach(function (field) {
        field.value = variant.id;
        field.dispatchEvent(new Event('change', { bubbles: true }));
      });

      // Keep the product URL's ?variant=... value in sync without reloading.
      try {
        var url = new URL(window.location.href);
        url.searchParams.set('variant', variant.id);
        window.history.replaceState({}, '', url.toString());
      } catch (e) {}
    }

    function sync(root) {
      var variant = findVariant(root);
      if (!variant) return;
      updateVariantId(root, variant);
      updatePrice(root, variant);
    }

    function init(root) {
      if (!root || root.__variantPriceSyncInitialized) return;
      root.__variantPriceSyncInitialized = true;

      root.addEventListener('change', function (event) {
        var target = event.target;
        if (target && (target.matches('input[name^="options["], select[name^="options["]') || target.closest('variant-selects'))) {
          // Allow the theme's own variant logic to run first, then enforce the
          // matching Shopify variant price/ID.
          window.setTimeout(function () { sync(root); }, 0);
        }
      });

      // Initial sync for the currently selected variant.
      window.setTimeout(function () { sync(root); }, 0);
    }

    function initAll() {
      var roots = document.querySelectorAll('product-info, .product, .product__info-wrapper, [data-section-type="product"]');
      if (!roots.length) roots = [document];
      roots.forEach(init);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }
  })();
</script>

